# Copy to .env and replace every value before running docker compose.
# The services refuse to start without these, by design.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# At least 32 characters, and identical across every service, or tokens will not verify.
RETAILBANK_JWT_SECRET=change-me-to-a-long-random-string-32-plus

# Base64, 32 bytes. Changing these makes existing encrypted data unreadable, and rotating the blind
# index key additionally requires a re-index.
RETAILBANK_DATA_KEY=change-me-base64-aes-256-key
RETAILBANK_BLIND_INDEX_KEY=change-me-base64-hmac-key

APP_LOG_LEVEL=INFO
